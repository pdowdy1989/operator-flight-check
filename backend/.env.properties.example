# Copy this file to .env.properties and fill in your own values.
# The real .env.properties is gitignored and should never be committed.

DB_URL=jdbc:mysql://localhost:3306/operator_flight_check?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your-local-mysql-password

# Must be at least 32 characters for HS256 JWT signing
JWT_SECRET=generate-a-long-random-string-at-least-32-chars

# Get a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your-openweather-api-key