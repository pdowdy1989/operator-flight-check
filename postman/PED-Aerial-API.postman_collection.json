{
  "info": {
    "_postman_id": "bf4d33dd-9dc5-4c34-8c39-1e9f7d8824af",
    "name": "PED Aerial API",
    "description": "Postman collection for the PED Aerial backend. Includes auth, health, saved spots, and drone profile flows with automatic JWT handling, request chaining, and response assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Keep the auth headers in sync for every protected request in the collection.",
          "const token = pm.environment.get('jwt_token');",
          "const userId = pm.environment.get('current_user_id');",
          "",
          "if (token && !pm.request.url.path.includes('auth')) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}",
          "",
          "if (userId && !pm.request.url.path.includes('auth')) {",
          "  pm.request.headers.upsert({ key: 'X-User-Id', value: userId });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{base_url}}"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Health payload reports service status', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('UP');",
                  "  pm.expect(json.service).to.eql('operator-flight-check-backend');",
                  "  pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Confirms that the backend is up before running authenticated flows."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique email so the register request can be rerun without manual edits.",
                  "const uniqueEmail = `pilot+${Date.now()}@pedaerial.com`;",
                  "pm.environment.set('register_email', uniqueEmail);",
                  "",
                  "if (!pm.environment.get('register_password')) {",
                  "  pm.environment.set('register_password', 'password123');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Register returns auth payload and location header', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/auth/me');",
                  "  pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.email).to.eql(pm.environment.get('register_email'));",
                  "  pm.expect(json.role).to.eql('USER');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "// Save the newly registered user for downstream requests.",
                  "const json = pm.response.json();",
                  "pm.environment.set('jwt_token', json.token);",
                  "pm.environment.set('current_user_id', json.id);",
                  "pm.environment.set('auth_email', json.email);",
                  "pm.environment.set('auth_password', pm.environment.get('register_password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a fresh user and stores the returned JWT + user id in the active environment."
          },
          "response": []
        },
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login returns a JWT for the configured user', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.email).to.eql(pm.environment.get('auth_email'));",
                  "  pm.expect(json.role).to.eql('USER');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.environment.set('jwt_token', json.token);",
                  "pm.environment.set('current_user_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{auth_email}}\",\n  \"password\": \"{{auth_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in with an existing user. By default this can use the seeded demo account or the user created in the register request."
          },
          "response": []
        },
        {
          "name": "GET /api/auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user endpoint returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Current user matches stored auth context', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.environment.get('current_user_id'));",
                  "  pm.expect(json.email).to.eql(pm.environment.get('auth_email'));",
                  "  pm.expect(json.role).to.eql('USER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Checks the currently authenticated user using the saved JWT."
          },
          "response": []
        }
      ]
    },
